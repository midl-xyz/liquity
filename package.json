{
  "name": "liquity",
  "private": true,
  "release": {
    "extends": "semantic-release-monorepo",
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "angular",
          "parserOpts": {
            "headerPattern": "^(\\w*)(?:\\((.*)\\))?!?: (.*)$"
          }
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "build:dev-frontend": "pnpm -w -F @liquity/dev-frontend build",
    "deploy": "pnpm -w -F @liquity/lib-ethers hardhat deploy",
    "deploy:chicken-bonds": "pnpm --dir ../ChickenBond deploy-fork compile publish:local",
    "watch:chicken-bonds": "pnpm --dir ../ChickenBond watch",
    "link:chicken-bonds": "pnpm -w -F @liquity/dev-frontend link:chicken-bonds",
    "unlink:chicken-bonds": "pnpm -w -F @liquity/dev-frontend unlink:chicken-bonds",
    "docs": "run-s 'docs:*'",
    "docs:collect-sdk-apis": "node scripts/collect-sdk-apis.js",
    "docs:api-documenter": "api-documenter generate -i temp/sdk-apis -o docs/sdk",
    "fuzzer": "pnpm -w -F @liquity/fuzzer fuzzer",
    "prepare:contracts": "pnpm -w -F @liquity/contracts prepare",
    "prepare:lib-base": "pnpm -w -F @liquity/lib-base prepare",
    "prepare:lib-ethers": "pnpm -w -F @liquity/lib-ethers prepare",
    "prepare:lib-react": "pnpm -w -F @liquity/lib-react prepare",
    "prepare:lib-subgraph": "pnpm -w -F @liquity/lib-subgraph prepare",
    "prepare:providers": "pnpm -w -F @liquity/providers prepare",
    "prepare:subgraph": "pnpm -w -F @liquity/subgraph prepare",
    "prepare:docs": "run-s docs",
    "rebuild": "run-s prepare build",
    "release": "run-s 'release:*'",
    "release:delete-dev-deployments": "pnpm -w -F @liquity/lib-ethers delete-dev-deployments",
    "release:lib-base": "pnpm -w -F @liquity/lib-base semantic-release",
    "release:lib-ethers": "pnpm -w -F @liquity/lib-ethers semantic-release",
    "release:lib-react": "pnpm -w -F @liquity/lib-react semantic-release",
    "release:providers": "pnpm -w -F @liquity/providers semantic-release",
    "save-live-version": "pnpm -w -F @liquity/lib-ethers save-live-version",
    "start-dev-chain": "run-s 'start-dev-chain:*'",
    "start-dev-chain:openethereum": "node dev-chain/start.js",
    "start-dev-chain:prepare-providers": "pnpm prepare:providers",
    "start-dev-chain:deploy-contracts": "pnpm deploy --network dev",
    "start-dev-chain:prepare-lib-ethers": "pnpm prepare:lib-ethers",
    "stop-dev-chain": "docker kill openethereum",
    "start-dev-frontend": "pnpm -w -F @liquity/dev-frontend start",
    "start-demo": "run-s 'start-demo:*'",
    "start-demo:dev-chain": "pnpm start-dev-chain",
    "start-demo:dev-frontend": "pnpm -w -F @liquity/dev-frontend start-demo",
    "stop-demo": "pnpm stop-dev-chain",
    "start-fork": "hardhat --config hardhat.config.mainnet-fork.ts node",
    "start-tunnel": "./scripts/start-local-tunnel.sh",
    "test": "run-s 'test:*'",
    "test:lib-base": "pnpm -w -F @liquity/lib-base test",
    "test:lib-ethers": "pnpm -w -F @liquity/lib-ethers test",
    "test:dev-frontend": "run-s --continue-on-error 'test:dev-frontend:*'",
    "test:dev-frontend:start-dev-chain": "pnpm start-dev-chain",
    "test:dev-frontend:run": "pnpm -w -F @liquity/dev-frontend test run",
    "test:dev-frontend:stop-dev-chain": "pnpm stop-dev-chain",
    "test-contracts": "pnpm -w -F @liquity/contracts test",
    "test-live": "run-s 'test-live:*'",
    "test-live:lib-ethers": "pnpm -w -F @liquity/lib-ethers test-live",
    "coverage": "run-s 'coverage:*'",
    "coverage:contracts": "pnpm -w -F @liquity/contracts coverage"
  },
  "packageManager": "pnpm@10.3.0",
  "devDependencies": {
    "@commitlint/cli": "^12.0.1",
    "@commitlint/config-conventional": "^12.0.1",
    "@microsoft/api-documenter": "^7.12.6",
    "fs-extra": "^9.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.1.2",
    "semantic-release": "^17.4.2",
    "semantic-release-monorepo": "^7.0.4",
    "turbo": "^2.5.4"
  },
  "dependencies": {
    "@midl-xyz/hardhat-deploy": "2.0.0-next.18",
    "@midl-xyz/midl-js-core": "2.0.0-next.18"
  }
}
